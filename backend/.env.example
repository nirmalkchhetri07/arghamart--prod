# Required
SECRET_KEY_BASE=change-me-generate-with-bin-rails-secret

# Database — both compose files configure this themselves (the quick-start
# compose sets DATABASE_URL; docker-compose.dev.yml sets DATABASE_HOST so dev
# and test each resolve their own database). Only set DATABASE_URL for
# non-Docker production-style runs: in .env it overrides database.yml inside
# the dev container and points every Rails env at one database.
# DATABASE_URL=postgres://postgres@localhost:5432/spree_production

# Database password — read by config/database.yml (development/test only; the
# Docker dev Postgres uses trust auth so it is ignored there). On the server it
# is also read by docker-compose.prod.yml and scripts/backup_db.sh.
# POSTGRES_PASSWORD=

# Web Server
PORT=3000
# RAILS_MAX_THREADS=3
# WEB_CONCURRENCY=1

# Background jobs (Solid Queue). The job supervisor runs inside Puma by
# default; set SOLID_QUEUE_IN_PUMA=false on the web service when running a
# dedicated `bin/jobs` service. JOB_THREADS sizes the worker pool (see
# config/queue.yml) — production defaults to 3, Docker dev to 10; raise it
# on a dedicated worker.
# SPREE_IMPORT_JOB_CONCURRENCY caps how many worker threads one CSV import
# may occupy at once (default: 75% of JOB_THREADS; 0 disables the cap).
# SOLID_QUEUE_IN_PUMA=true
# JOB_THREADS=3
# SPREE_IMPORT_JOB_CONCURRENCY=2

# Job dashboard (/jobs) HTTP Basic auth — required in production, defaults
# to spree / spree123 in development
# MISSION_CONTROL_USER=
# MISSION_CONTROL_PASSWORD=

# Docker host ports — override when another project already holds the default.
# Postgres binds to 127.0.0.1. SPREE_DB_PORT applies to docker-compose.dev.yml
# only (the quick-start compose doesn't publish Postgres). SPREE_MEILISEARCH_PORT
# applies only when the optional meilisearch compose service is enabled.
# SPREE_PORT=3000
# SPREE_DB_PORT=5433
# SPREE_MEILISEARCH_PORT=7700

# SSL (defaults to true in production — set to false for local dev or non-SSL proxies)
# RAILS_FORCE_SSL=false
# RAILS_ASSUME_SSL=false

# Public host (production) — used for all generated URLs: image/attachment URLs
# in API responses, links in emails. Host only, optionally with a port
# (e.g. store.example.com or 203.0.113.7:8080). URLs use https unless both
# RAILS_FORCE_SSL and RAILS_ASSUME_SSL are false.
# RAILS_HOST=store.example.com

# JWT signing key for the Store/Admin API v3. Spree reads ENV["JWT_SECRET_KEY"]
# (fallback chain: Spree::Api::Config[:jwt_secret_key] -> Rails credentials ->
# JWT_SECRET_KEY -> SECRET_KEY_BASE). Set it explicitly in production so tokens
# don't depend on SECRET_KEY_BASE. Generate with `bin/rails secret`.
# JWT_SECRET_KEY=

# Optional CDN host for serving assets and images (host only, no protocol)
# CDN_HOST=cdn.example.com

# Email (SMTP) — set SMTP_HOST to enable email delivery, otherwise emails are
# logged (Letter Opener in development). docker-compose.yml pins SMTP_HOST to
# Mailpit for the dev container, so these only take effect in native dev and
# production.
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=store@example.com

# File Storage — auto-detected from credentials, falls back to local disk
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_BUCKET=spree-production

# Cloudflare R2 — image/attachment bucket (Active Storage). Accepted under
# either name: CLOUDFLARE_* (Spree docs naming) or the shorter R2_*; when both
# are set, CLOUDFLARE_* wins. Picked up by config/storage.yml and by the
# auto-detection in config/environments/production.rb.
# CLOUDFLARE_ENDPOINT=
# CLOUDFLARE_ACCESS_KEY_ID=
# CLOUDFLARE_SECRET_ACCESS_KEY=
# CLOUDFLARE_BUCKET=spree-production
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=spree-production
#
# The bucket must already exist and the API token needs Object Read & Write on
# it — a wrong bucket name surfaces only as failed uploads. Verify the whole
# config with a real round trip:
#
#   bin/rails storage:check
#
# (At boot the app logs "[storage] ..." lines describing what it detected; a
# partial R2 config silently falls back to local disk.)

# Error Tracking
# SENTRY_DSN=

# Application
# RAILS_ENV=production
# RAILS_LOG_LEVEL=info

# Search — product search runs on the database by default. To switch to
# Meilisearch, set MEILISEARCH_URL (uncomment the meilisearch blocks in the
# compose file when using Docker, or point at your own instance) and reindex
# with `bin/rails spree:search:reindex`.
# MEILISEARCH_URL=
# MEILISEARCH_API_KEY=

# Spree core development — set to path of spree monorepo to use local gems
# SPREE_PATH=../spree

# Daily Postgres backups -> private Cloudflare R2 bucket (see
# scripts/backup_db.sh, docs/BACKUPS.md). Names only - real values live in
# .env.production on the server and are never committed.
# BACKUP_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# BACKUP_R2_ACCESS_KEY_ID=
# BACKUP_R2_SECRET_ACCESS_KEY=
# BACKUP_R2_BUCKET=arghamart-backups
# Failure alert webhook (Slack/Discord {"text"} format) and optional
# healthchecks.io-style ping URL so missed runs get noticed.
# BACKUP_ALERT_WEBHOOK_URL=
# BACKUP_HEALTHCHECK_URL=
