<%# Shared add/edit form. The secret field is blank by design: on edit a
    blank value keeps the stored secret; only a typed value replaces it. %>
<% provider_options = Spree::Oauth::Providers.all.map do |e| %>
<%   label = e.implemented ? e.label : "#{e.label} (#{Spree.t('admin.oauth.coming_soon')})" %>
<%   [label, e.key, { disabled: !e.implemented }] %>
<% end %>
<div class="card mb-4">
  <div class="card-body flex flex-col gap-3">
    <div class="form-group">
      <%= f.label :provider, Spree.t('admin.oauth.provider') %>
      <% if f.object.persisted? %>
        <%= f.text_field :provider, disabled: true, class: "form-input" %>
      <% else %>
        <%= f.select :provider, provider_options,
              { include_blank: Spree.t('admin.oauth.select_provider') },
              { class: "form-input", required: true } %>
        <small class="form-text text-muted"><%= Spree.t('admin.oauth.coming_soon_hint') %></small>
      <% end %>
    </div>
    <div class="form-group">
      <%= f.label :name, Spree.t('admin.oauth.display_name') %>
      <%= f.text_field :name, class: "form-input", required: true,
            placeholder: Spree.t('admin.oauth.display_name_placeholder') %>
    </div>
    <div class="form-group">
      <% facebook = f.object.provider == 'facebook' %>
      <%= f.label :client_id, facebook ? Spree.t('admin.oauth.app_id') : Spree.t('admin.oauth.client_id') %>
      <%= f.text_field :client_id, class: "form-input", required: true, autocomplete: "off" %>
    </div>
    <div class="form-group">
      <%= f.label :client_secret, facebook ? Spree.t('admin.oauth.app_secret') : Spree.t('admin.oauth.client_secret') %>
      <%= f.password_field :client_secret, value: "", class: "form-input", autocomplete: "new-password",
            required: facebook && f.object.new_record?,
            placeholder: f.object.persisted? ? Spree.t('admin.oauth.secret_keep_hint') : "" %>
      <small class="form-text text-muted"><%= facebook ? Spree.t('admin.oauth.secret_hint_facebook') : Spree.t('admin.oauth.secret_hint') %></small>
    </div>
    <div class="form-group">
      <%= f.label :position, Spree.t('admin.oauth.position') %>
      <%= f.number_field :position, class: "form-input", min: 0, step: 1 %>
    </div>
    <label class="flex items-center gap-2 text-sm">
      <%= f.check_box :enabled %>
      <%= Spree.t(:enabled) %>
    </label>
  </div>
</div>
