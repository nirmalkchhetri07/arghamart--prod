<%# Override of spree_admin's payments/_payment card: identical to the gem
    partial except for the Manual QR review block at the end (proof image,
    verification status, Approve/Reject). Copied in full because Rails picks
    the host file entirely — see AGENTS/skill notes on admin overrides. %>
<div class="card" id="<%= dom_id(payment) %>">
  <div class="card-header flex items-center gap-2">
    <span class="badge badge-<%= payment.state %> gap-1">
      <% if payment.completed? %>
        <%= icon('check') %>
      <% elsif payment.invalid? || payment.void? || payment.failed? %>
        <%= icon('x') %>
      <% else %>
        <%= icon('progress') %>
      <% end %>
      <%= Spree.t('payment_states.' + payment.state) %>
    </span>
    <% if payment.payment_method.present? && payment.payment_method.payment_icon_name.present? %>
      <%= payment_method_icon_tag(payment.payment_method.payment_icon_name) %>
    <% end %>
    <strong><%= payment.number.upcase %></strong>
    <%= spree_time(payment.created_at, class: 'ms-auto text-gray-600 text-sm') %>

    <%= dropdown do %>
      <%= dropdown_toggle class: 'btn-light btn-sm px-1' do %>
        <%= icon('dots-vertical', class: 'mr-0') %>
      <% end %>
      <%= dropdown_menu do %>
        <% if payment.try(:gateway_dashboard_payment_url).present? %>
          <%= link_to_with_icon 'eye', Spree.t(:details), payment.gateway_dashboard_payment_url, class: 'dropdown-item', target: '_blank' %>
        <% end %>
        <% if payment.source.is_a?(Spree::StoreCredit) && payment.source.originator_type == 'Spree::GiftCard' %>
          <%= link_to_with_icon 'eye', Spree.t(:details), spree.admin_gift_card_path(payment.source.originator), class: 'dropdown-item' %>
        <% end %>

        <% if can?(:update, payment) && (payment.checkout? || payment.pending?) && payment.payment_method.present? %>
          <%= link_to_with_icon 'check', Spree.t(:capture), spree.capture_admin_order_payment_path(@order, payment), class: 'dropdown-item', data: { turbo_method: :put, turbo_confirm: Spree.t(:are_you_sure) } %>
        <% end %>
        <% if can?(:refund, @order) && payment.completed? && payment.can_credit? && payment.payment_method.present? %>
          <%= link_to_with_icon 'credit-card-refund', Spree.t(:refund), spree.new_admin_order_payment_refund_path(@order, payment), class: 'dropdown-item', data: { turbo_method: :put, turbo_confirm: Spree.t(:are_you_sure) } %>
        <% end %>
        <% if can?(:cancel, payment) && payment.pending? && payment.payment_method.present? %>
          <div class="dropdown-divider"></div>
          <%= link_to_with_icon 'cancel', Spree.t(:void), spree.void_admin_order_payment_path(@order, payment), class: 'dropdown-item text-red-600 hover:bg-red-100', data: { turbo_method: :put, turbo_confirm: Spree.t(:are_you_sure) } %>
        <% end %>
        <% if can?(:destroy, payment) && payment.can_be_deleted? %>
          <div class="dropdown-divider"></div>
          <%= link_to_with_icon 'trash', Spree.t('actions.destroy'), spree.admin_order_payment_path(@order, payment), class: 'dropdown-item text-red-600 hover:bg-red-100', data: { turbo_method: :delete, turbo_confirm: Spree.t(:are_you_sure) } %>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <div class="card-body">
    <% if payment.gateway_processing_error_messages.any? %>
      <div class="alert alert-danger inline-block">
        <strong><%= Spree.t(:payments_gateway_processing_errors, payment_method_name: payment.payment_method&.name) %>:</strong>
        <%= payment.gateway_processing_error_messages.join(', ') %>
      </div>
    <% end %>

    <div class="flex">
      <div class="w-1/2">
        <p class="mb-0.5"><%= Spree.t(:amount) %>:</p>
        <strong><%= payment.display_amount %></strong>

        <p class="mb-0.5 mt-2"><%= Spree.t(:payment_method) %>:</p>
        <strong><%= payment_method_name(payment) %></strong>

        <% if payment.transaction_id.present? %>
          <p class="mb-0.5 mt-2">
            <%= Spree.t(:transaction_id) %>
            <%= help_bubble(Spree.t(:transaction_id_help)) %>
          </p>
          <strong><%= payment.transaction_id %></strong>
        <% end %>
      </div>
      <% if payment.source.present? %>
        <div class="w-1/2">
          <p class="mb-2"><%= Spree.t(:payment_source) %>:</p>
          <div class="rounded-xl bg-gray-25 border shadow-xs p-4">
            <%= render 'spree/shared/payment', payment: payment %>
          </div>
        </div>
      <% end %>
    </div>

    <%# Manual QR review: proof screenshot next to the money it must be
        checked against (amount due vs claimed), the fraud checks (reused
        transaction ID, re-filed screenshot), verification status, and
        Approve/Reject for pending payments. %>
    <% if payment.manual_qr? %>
      <div class="mt-4 rounded-xl bg-gray-25 border shadow-xs p-4">
        <p class="mb-2">
          <strong><%= Spree.t(:qr_proof) %></strong>
          <span class="badge badge-<%= payment.state %> ms-2">
            <%= Spree.t("qr_statuses.#{payment.qr_status}") %>
          </span>
        </p>

        <div class="flex flex-wrap items-start gap-4">
          <div>
            <% if payment.proof_image.attached? %>
              <%= link_to spree.proof_admin_order_payment_path(@order, payment), target: '_blank', rel: 'noopener' do %>
                <%= image_tag spree.proof_admin_order_payment_path(@order, payment),
                      class: 'max-w-[320px] rounded border', alt: Spree.t(:qr_proof) %>
              <% end %>
            <% else %>
              <p class="text-sm text-gray-500"><%= Spree.t(:no_qr_proof_uploaded) %></p>
            <% end %>
          </div>

          <%# The money to check the screenshot against, plus the reuse
              flags — kept beside the image so review is one glance. %>
          <div class="text-sm min-w-[220px]">
            <p class="mb-0.5"><%= Spree.t(:qr_amount_due) %>:</p>
            <strong class="text-base"><%= @order.display_amount_due %></strong>

            <p class="mb-0.5 mt-2"><%= Spree.t(:qr_payment_amount) %>:</p>
            <strong class="text-base"><%= payment.display_amount %></strong>

            <% if payment.qr_amount_mismatch? %>
              <p class="mt-2">
                <span class="badge badge-warning"><%= icon('alert-circle') %> <%= Spree.t(:qr_amount_mismatch) %></span>
              </p>
            <% end %>

            <% if payment.qr_transaction_id.present? %>
              <p class="mt-2">
                <%= Spree.t(:qr_transaction_id) %>:
                <strong><%= payment.qr_transaction_id %></strong>
              </p>
            <% end %>

            <% if (transaction_duplicates = payment.qr_transaction_id_duplicate_count).positive? %>
              <p class="mt-1">
                <span class="badge badge-danger"><%= icon('alert-circle') %> <%= Spree.t('qr_transaction_reused', count: transaction_duplicates) %></span>
              </p>
            <% end %>

            <% if (proof_duplicates = payment.qr_proof_duplicate_count).positive? %>
              <p class="mt-1">
                <span class="badge badge-danger"><%= icon('alert-circle') %> <%= Spree.t('qr_proof_reused', count: proof_duplicates) %></span>
              </p>
            <% end %>
          </div>
        </div>

        <% if payment.qr_status == 'rejected' && payment.qr_rejection_reason.present? %>
          <p class="mt-2 text-sm">
            <%= Spree.t(:qr_rejection_reason) %>:
            <strong><%= payment.qr_rejection_reason %></strong>
          </p>
        <% end %>

        <% if payment.pending? %>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <% if can?(:update, payment) %>
              <%= link_to Spree.t(:approve_qr_payment),
                    spree.approve_admin_order_payment_path(@order, payment),
                    class: 'btn btn-success btn-sm',
                    data: { turbo_method: :put, turbo_confirm: Spree.t(:are_you_sure) } %>
            <% end %>
            <% if can?(:cancel, payment) %>
              <%= form_with url: spree.reject_admin_order_payment_path(@order, payment),
                            method: :put, class: 'flex flex-wrap items-center gap-2' do |f| %>
                <%= f.text_field 'payment[qr_rejection_reason]',
                      placeholder: Spree.t(:qr_rejection_reason),
                      class: 'form-control form-control-sm w-auto' %>
                <%= f.submit Spree.t(:reject_qr_payment),
                      class: 'btn btn-danger btn-sm',
                      data: { turbo_confirm: Spree.t(:are_you_sure) } %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
  <% if payment.transaction_id.present? && !payment.store_credit? %>
    <div class="card-footer border-t border-dashed py-3" data-controller="reveal">
      <p class="mb-0 flex justify-between items-center">
        <span>
          <%= Spree.t(:risk_analysis) %>
          &nbsp;
          <% if @order.is_risky? %>
            <span class="badge badge-warning"><%= icon('shield-off') %> <%= Spree.t(:risky) %></span>
          <% else %>
            <span class="text-green-700"><%= icon('shield-check-filled') %> <%= Spree.t(:not_risky) %></span>
          <% end %>
        </span>
        <button type="button" class="btn btn-light btn-sm" data-action="click->reveal#toggle">
          <%= Spree.t(:show_details) %>
          <%= icon('selector', class: 'mr-0 ml-0.5') %>
        </button>
      </p>
      <%= render 'spree/admin/orders/risk_analysis', payment: payment %>
    </div>
  <% end %>
</div>
