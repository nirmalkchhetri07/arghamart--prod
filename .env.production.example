# Template for .env.production (which is gitignored — copy this file on the
# server:  cp .env.production.example .env.production  and fill in secrets).
#
# Used by docker-compose.prod.yml for container settings (${...} interpolation,
# pass it with --env-file) and by the Rails app itself (anything else in this
# file is read by config/environments/production.rb via env_file).
#
# ── Required ──────────────────────────────────────────────────────────────
# Database password; interpolated into compose's POSTGRES_PASSWORD and the
# app's DATABASE_URL. Fails loudly if unset. Existing volume: changing this
# later does NOT re-init Postgres, but the app would lose access — update both
# sides together.
POSTGRES_PASSWORD=

# ── Optional (defaults shown) ─────────────────────────────────────────────
# Database name/user — must match the initialized volume.
#POSTGRES_DB=spree_production
#POSTGRES_USER=postgres
# Postgres image tag (bump to upgrade; see PGDATA below).
#POSTGRES_IMAGE=postgres:18-alpine
# Where the web container publishes on the loopback interface. nginx on this
# host proxies https://api.arghahub.tech → 127.0.0.1:3000 — keep WEB_BIND_IP
# at 127.0.0.1 so the app is never exposed directly.
#WEB_PORT=3000
#WEB_BIND_IP=127.0.0.1

# ── Rails / Active Storage ────────────────────────────────────────────────
# Cloudflare R2 (Active Storage) — bucket must exist with Object Read & Write.
#R2_ENDPOINT=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#R2_BUCKET=
# Host used to build URLs (storefront/API origin behind nginx).
#RAILS_HOST=api.arghahub.tech
#SECRET_KEY_BASE=
